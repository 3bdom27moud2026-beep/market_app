{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antigravity.ai/schemas/chat_message.json",
  "title": "ChatMessage",
  "description": "A single customer support message payload matching Flutter MessageEntity shape.",
  "type": "object",
  "properties": {
    "id": { "type": "integer", "description": "Unique message identifier from backend database." },
    "chat_id": { "type": "integer", "description": "Parent conversation thread ID." },
    "user_id": { "type": ["integer", "null"], "description": "Support agent user ID if sent by agent, null if sent by customer." },
    "sender": { "type": "string", "enum": ["customer", "agent", "system", "bot"], "description": "Message sender role." },
    "text": { "type": ["string", "null"], "description": "Text content of the message." },
    "type": { "type": "string", "enum": ["text", "image", "audio", "document", "location"], "description": "Payload media type." },
    "media_url": { "type": ["string", "null"], "format": "uri", "description": "URL to media file if type is not text." },
    "caption": { "type": ["string", "null"], "description": "Optional media caption." },
    "status": { "type": "string", "enum": ["sent", "delivered", "read", "failed"], "description": "Delivery status." },
    "created_at": { "type": ["string", "null"], "format": "date-time", "description": "ISO 8601 UTC timestamp." }
  },
  "required": ["id", "chat_id", "sender", "type"],
  "examples": [
    {
      "id": 99104,
      "chat_id": 4821,
      "user_id": null,
      "sender": "customer",
      "text": "Where is my order #58210?",
      "type": "text",
      "media_url": null,
      "caption": null,
      "status": "delivered",
      "created_at": "2026-08-04T12:00:00Z"
    }
  ]
}
