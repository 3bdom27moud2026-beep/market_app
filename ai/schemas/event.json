{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antigravity.ai/schemas/event.json",
  "title": "Event",
  "description": "A travel or local event such as a concert, cultural festival, or guided tour.",
  "type": "object",
  "properties": {
    "event_id": { "type": "string", "examples": ["evt_9921"] },
    "name": { "type": "string", "examples": ["Ubud Writers Festival"] },
    "category": { "type": "string", "examples": ["cultural", "music", "sports", "food"] },
    "location": { "$ref": "location.json" },
    "start_datetime": { "type": "string", "format": "date-time" },
    "end_datetime": { "type": "string", "format": "date-time" },
    "price_usd": { "type": "number", "minimum": 0 },
    "currency": { "type": "string", "examples": ["USD", "IDR"] },
    "description": { "type": "string" },
    "image_url": { "type": "string", "format": "uri" },
    "available_tickets": { "type": "integer" },
    "organizer": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["event_id", "name", "category", "location", "start_datetime", "price_usd", "currency"],
  "examples": [
    {
      "event_id": "evt_9921",
      "name": "Kecak Fire Dance",
      "category": "cultural",
      "location": { "lat": -8.409518, "lng": 115.188919, "address": "Uluwatu Temple, Bali" },
      "start_datetime": "2026-08-10T18:00:00Z",
      "end_datetime": "2026-08-10T19:30:00Z",
      "price_usd": 15.00,
      "currency": "USD",
      "description": "Traditional Balinese Kecak dance performed at sunset.",
      "available_tickets": 200
    }
  ]
}
