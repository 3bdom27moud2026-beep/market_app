{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antigravity.ai/schemas/intent_classification.json",
  "title": "IntentClassification",
  "description": "Output schema from Reasoning module categorizing customer intent and extracted entities.",
  "type": "object",
  "properties": {
    "intent": { "type": "string", "enum": ["faq_hours", "faq_location", "order_inquiry", "cancellation", "billing_dispute", "complaint", "general_inquiry"] },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "sentiment_score": { "type": "number", "minimum": -1.0, "maximum": 1.0 },
    "urgency": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "entities": {
      "type": "object",
      "properties": {
        "order_id": { "type": ["string", "null"] },
        "phone_number": { "type": ["string", "null"] },
        "date": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "required": ["intent", "confidence", "sentiment_score", "urgency"],
  "examples": [
    {
      "intent": "order_inquiry",
      "confidence": 0.94,
      "sentiment_score": -0.1,
      "urgency": "medium",
      "entities": {
        "order_id": "58210"
      }
    }
  ]
}
